# Zetaris (local install). Create the API key yourself in the Zetaris web UI (http://localhost:3000).
ZETARIS_API_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=
ZETARIS_ORG_ID=1

# Meterless Nightshift Runtime (primary AI provider). Copy both from Nightshift's Console.
# The NVIDIA key is NOT set here: it lives in Nightshift -> Setup -> Providers.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# Leave empty to read the token from Nightshift's runtime-token file automatically.
METERLESS_RUNTIME_TOKEN=
METERLESS_TOKEN_FILE=

# Server
PORT=8799

# Local demo shop database (docker-compose.yml). Any local value works.
SHOP_DB_PASSWORD=
SHOP_DB_PORT=55432
