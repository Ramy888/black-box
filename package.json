{
  "name": "black-box",
  "version": "0.1.0",
  "description": "Black Box: a crash investigator for AI agents. Built on Zetaris, Meterless and NVIDIA Nemotron.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "setup": "npx --yes degit --force meterless/meterless/engines/hmem/reference vendor/hmem && npx --yes degit --force meterless/meterless/engines/world-model/reference vendor/world-model",
    "dev": "tsx watch server/index.ts",
    "dev:web": "vite web",
    "build": "tsc --noEmit && vite build web",
    "test": "vitest run",
    "check:zetaris": "tsx scripts/check-zetaris.ts",
    "check:nightshift": "tsx scripts/check-nightshift.ts",
    "scenario:load": "tsx scenario/load.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
